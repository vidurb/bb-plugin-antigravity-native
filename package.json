{
  "name": "bb-plugin-antigravity-native",
  "version": "0.1.0",
  "description": "Run BB threads using the native agy acp server.",
  "type": "module",
  "license": "MIT",
  "author": "vidurb",
  "repository": {
    "type": "git",
    "url": "https://github.com/vidurb/bb-plugin-antigravity-native.git"
  },
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Antigravity Native",
    "description": "Run Antigravity threads through the native agy acp server with models, reasoning, and tool approvals in BB.",
    "branding": {
      "icon": "Orbit"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:live": "node --experimental-strip-types scripts/smoke.ts",
    "test:tools": "node --experimental-strip-types scripts/smoke-tools.ts"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.104"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
