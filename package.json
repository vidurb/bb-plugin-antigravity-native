{
  "name": "bb-plugin-antigravity-native",
  "version": "0.2.0",
  "description": "Run BB threads using the native agy acp server.",
  "type": "module",
  "license": "MIT",
  "author": "vidurb",
  "repository": {
    "type": "git",
    "url": "https://github.com/vidurb/bb-plugin-antigravity-native.git"
  },
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Antigravity Native",
    "description": "Run Antigravity coding tasks in BB with native ACP, account quota reporting, tool approvals, skills, and compaction.",
    "branding": {
      "icon": "./icons/antigravity.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:live": "node --experimental-strip-types scripts/smoke.ts",
    "test:tools": "node --experimental-strip-types scripts/smoke-tools.ts",
    "test:maintenance": "node --experimental-strip-types scripts/smoke-maintenance.ts --health",
    "test:skills": "node --experimental-strip-types scripts/smoke-skills.ts"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  }
}
